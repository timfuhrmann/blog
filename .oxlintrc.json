{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "react-hooks", "jsx-a11y", "nextjs", "typescript"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/purity": "warn"
  },
  "ignorePatterns": [".next/**", "out/**", "build/**", "next-env.d.ts"]
}
